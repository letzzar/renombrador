# ============================================================================
#  Configuración del servicio Renombrador TMDb
#  Copia este archivo a «.env» (cp .env.example .env) y edítalo.
# ============================================================================

# ---------------------------------------------------------------------------
#  OBLIGATORIO
# ---------------------------------------------------------------------------
# Clave API (v3 auth) de TMDb. Gratuita: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ---------------------------------------------------------------------------
#  RUTAS DEL HOST  (carpetas de TU equipo que se montan en el contenedor)
#  Usa rutas absolutas en un NAS/servidor, p. ej. /mnt/datos/descargas
# ---------------------------------------------------------------------------
DOWNLOADS_DIR=./datos/descargas
MOVIES_HOST_DIR=./datos/peliculas
SERIES_HOST_DIR=./datos/series
CONFIG_DIR=./datos/config

# ---------------------------------------------------------------------------
#  COMPORTAMIENTO
# ---------------------------------------------------------------------------
# Idioma de los títulos: es-ES, es-MX, en-US, en-GB, fr-FR, de-DE, it-IT, pt-BR
TMDB_LANGUAGE=es-ES

# Estructura de carpetas de destino:
#   true  -> anidada estilo Plex/Jellyfin (recomendado)
#            Peliculas/Titulo (Año)/Titulo (Año).mkv
#            Series/Serie (Año)/Season 01/Serie 1x01 Episodio.mkv
#   false -> plana (todo directo en la carpeta destino)
NESTED=true

# Formato del año en carpetas/archivos:
#   parens   -> Título (2021)   [estándar Plex/Jellyfin, recomendado]
#   brackets -> Título [2021]
YEAR_FORMAT=parens

# Agrupar películas de una saga en una carpeta con el nombre de la colección
# de TMDb (tal cual), p. ej. "El Padrino - Colección/". Solo en modo anidado.
USE_COLLECTIONS=true

# Formato del código de episodio: 1x05  o  S01E05
EPISODE_FORMAT=1x05

# Tipo de contenido: auto (detecta por el nombre), series o movies
FORCE_MODE=auto

# Qué hacer cuando TMDb no da un resultado fiable:
#   revisar -> mover el archivo a la carpeta _revisar (cuarentena)
#   dejar   -> dejarlo en descargas y solo avisar en el log
#   forzar  -> usar igualmente el mejor candidato (puede equivocarse)
ON_UNCERTAIN=revisar

# Umbral de similitud [0..1] por encima del cual se renombra sin dudar.
MATCH_THRESHOLD=0.85

# ---------------------------------------------------------------------------
#  SONDEO Y SEGURIDAD
# ---------------------------------------------------------------------------
# Cada cuántos segundos se revisa la carpeta de descargas.
POLL_INTERVAL=30

# Un archivo solo se procesa cuando lleva este nº de segundos sin cambiar de
# tamaño (evita tocar descargas a medias).
STABLE_SECS=60

# Tamaño mínimo (MB) para considerar un archivo (descarta «samples»).
MIN_FILE_MB=50

# Borrar las subcarpetas que queden vacías en descargas tras mover el vídeo
# (p. ej. la carpeta que crean los clientes torrent). true/false
CLEAN_EMPTY_DIRS=false

# Carpeta de cuarentena para matches dudosos (por defecto, dentro de descargas).
# REVIEW_DIR=/descargas/_revisar

# ---------------------------------------------------------------------------
#  SISTEMA
# ---------------------------------------------------------------------------
# Zona horaria del contenedor (para las marcas de tiempo de los logs de Docker).
TZ=Europe/Madrid
